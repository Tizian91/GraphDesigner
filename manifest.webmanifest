{
  "name": "Diagramm-Designer",
  "short_name": "Diagramm-Designer",
  "description": "Diagramme aus Tabellendaten gestalten und als PNG, SVG, PDF oder für Word exportieren.",
  "lang": "de",
  "id": "./PlotTransformer.html",
  "start_url": "./PlotTransformer.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f7",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./PlotTransformer.html",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/csv": [".csv"],
        "text/tab-separated-values": [".tsv"],
        "text/plain": [".txt"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"]
      }
    }
  ]
}
